#ifndef DYN_ARR_H
#define DYN_ARR_H

#include <assert.h> // IWYU pragma: export
#include <string.h> // IWYU pragma: export
#include <stdlib.h> // IWYU pragma: export

#define DEFINE_DYN_ARR(name, type) \
    typedef struct { \
        type *data; \
        size_t size; \
        size_t cap; \
    } name; \
    \
    static inline int name##_init(name *arr, size_t init_cap) { \
        assert(arr); \
        \
        if (!arr) \
            return -1; \
        \
        *arr = (name){0}; \
        \
        if (init_cap > 0) { \
            arr->data = malloc(init_cap * sizeof(*arr->data)); \
            if (!arr->data) \
                return -1; \
        \
            arr->cap = init_cap; \
        } \
        \
        return 0; \
    } \
    \
    static inline void name##_free(name *arr) { \
        if (!arr) \
            return; \
        \
        free(arr->data); \
        *arr = (name){0}; \
    } \
    \
    static inline type *name##_push(name *arr) { \
        assert(arr); \
        assert(arr->size <= arr->cap); \
        \
        if (!arr || arr->size > arr->cap) \
            return NULL; \
        \
        if (arr->size == arr->cap) { \
            if (arr->cap == 0) \
                ++arr->cap; \
            else \
                arr->cap *= arr->cap; \
            \
            size_t new_cap = arr->cap * 2; \
            \
            void *tmp = realloc(arr->data, new_cap * sizeof(*arr->data)); \
            if (!tmp) \
                return NULL; \
            \
            arr->data = tmp; \
            arr->cap = new_cap; \
        } \
        \
        memset(&arr->data[arr->size], 0, sizeof(*arr->data)); \
        return &arr->data[arr->size++]; \
    } \

#endif
